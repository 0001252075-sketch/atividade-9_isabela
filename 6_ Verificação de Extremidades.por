programa {
  funcao inicio() {
  inteiro numeros[4] 

  escreva("Digite o 1 número: ")
  leia(numeros[0])
   
  escreva("Digite o 2 número: ")
  leia(numeros[1])

  escreva("Digite o 3 número: ")
  leia(numeros[2])

  escreva("Digite o 4 número: ")
  leia(numeros[3])

  se(numeros[0] == numeros[3])
  escreva("O numero é igual")
  senao
  escreva("O numero não é igual")
    
  }
}
