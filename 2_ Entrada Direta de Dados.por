programa {
  funcao inicio() {
    cadeia comidas [3]
    escreva("Escreva o nome da sua primeira comida favorita: ")
    leia(comidas[0])
    escreva("Escreva o nome da sua segunda comida favorita: ")
    leia(comidas[1])
    escreva("Escreva o nome da sua terceira comida favorita:  ")
    leia(comidas[2])
  
    escreva("O nome da comida guardada na posiçao do meio é: ", comidas[2])
    
  }
}
