programa {
  funcao inicio() {
  real vetor[3]
      
  escreva("Digite o valor para a posição de índice 0: ")
  leia(vetor[0])
        
  escreva("Digite o valor para a posição de índice 1: ")
  leia(vetor[1])
        
      
  vetor[2] = vetor[0] + vetor[1]
        
  escreva("Índice 0: ", vetor[0], "\n")
  escreva("Índice 1: ", vetor[1], "\n")
  escreva("Índice 2: ", vetor[2], "\n")
    
  }
}
