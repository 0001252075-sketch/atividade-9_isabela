programa {
  funcao inicio() {
  cadeia cor[3]
  escreva("Escreva o nome da primeira cor: ")
  leia(cor[0])
  
  escreva("Escreva o nome da segunda cor: ")
  leia(cor[1])

  escreva("Escreva o nome da terceira cor: ")
  leia(cor[2]) 

  escreva("Posição [0]: ", cor[2], "\n")
	escreva("Posição [1]: ", cor[1], "\n")
  escreva("Posição [2]: ", cor[0], "\n")
    
  }
}
